<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Scrollable Top Section: Header, Connection Status, Discovery, Devices -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Voice P2P"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ultra-Fast BLE Discovery + High-Speed Offline Voice Transfer"
                android:textSize="13sp"
                android:textColor="#666666" />

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: "
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disconnected"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_disconnected" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMyDeviceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="My Device: Initializing..."
                        android:textSize="13sp"
                        android:textColor="#444444" />

                    <TextView
                        android:id="@+id/tvRoleDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Connection: Google Nearby (Fast BLE + Wi-Fi)"
                        android:textSize="13sp"
                        android:textColor="#444444" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Controls (Advertise & Discover) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdvertise"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Advertise"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscover"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Discover"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="10dp" />

            </LinearLayout>

            <!-- Disconnect Button (Prominent, Styled Danger Button) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="Disconnect Device"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/disconnect_btn_stroke"
                android:textColor="@color/disconnect_btn_text"
                app:icon="@drawable/ic_disconnect"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/disconnect_btn_text"
                app:rippleColor="@color/disconnect_btn_ripple" />

            <!-- Peers List Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Available Nearby Devices"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvEmptyDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No devices found. Tap 'Discover' or 'Advertise' to connect."
                android:textSize="13sp"
                android:textColor="#888888" />

            <ListView
                android:id="@+id/lvDevices"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#FAFAFA"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Section: Received Data + Language Dropdown + Speak Button just above navigation bar -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header: Received Data Title & Language Selector Dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReceivedDataTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Received Data"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <!-- TTS Listen Button to speak/replay received text aloud in English -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayReceivedAudio"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🔊 Speak"
                android:textSize="12sp"
                android:textColor="#1976D2" />

            <!-- Language Dropdown (Replaces old 'Model Ready' text) -->
            <Spinner
                android:id="@+id/spLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- Model Status Loading Subtitle -->
        <TextView
            android:id="@+id/tvModelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Model: English (Ready)"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#666666" />

        <!-- Received Data Display Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F8F9FA"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD">

            <ScrollView
                android:id="@+id/scrollReceivedData"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:fillViewport="true"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvReceivedData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for data from peer device...\n"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#222222" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Local Speaking Status / Live Speech Preview -->
        <TextView
            android:id="@+id/tvSpeakingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#1976D2"
            android:visibility="gone" />

        <!-- Simple Speak Button at the very end of screen just above navigation bar -->
        <Button
            android:id="@+id/btnToggleSpeaking"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Start speaking"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>